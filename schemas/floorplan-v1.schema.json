{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dr-dimitri/heizlast-ha/blob/main/schemas/floorplan-v1.schema.json",
  "title": "Heizlast HA floor plan, version 1.0",
  "description": "Floor plans in original image pixel coordinates. IDs must be globally unique across floors and rooms. Room polygons are implicitly closed; metric areas need independent verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "floors"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "floors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/floor" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 8192 },
        { "type": "number", "minimum": 0, "maximum": 8192 }
      ],
      "items": false
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "polygon", "area_m2"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "maxItems": 500,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/point" }
        },
        "area_m2": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "background", "canvas", "rooms"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "background": { "type": "string", "minLength": 1, "maxLength": 512 },
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
          }
        },
        "rooms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/room" }
        }
      }
    }
  }
}
